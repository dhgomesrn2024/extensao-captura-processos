{
  "manifest_version": 3,
  "name": "Captura de processos (PJe e SEEU)",
  "version": "0.8.0",
  "description": "Migra o acervo do PJe e do SEEU: percorre o painel do advogado, baixa cada processo, identifica os clientes por OAB e exporta tudo em um JSON. (PJe v5 · SEEU v3)",
  "permissions": ["activeTab", "scripting", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Capturar processo do PJe",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
